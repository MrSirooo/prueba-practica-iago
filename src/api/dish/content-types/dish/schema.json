{
  "kind": "collectionType",
  "collectionName": "dishes",
  "info": {
    "singularName": "dish",
    "pluralName": "dishes",
    "displayName": "dish"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "allergenList": {
      "type": "component",
      "component": "restaurant.allergen",
      "repeatable": true
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "primero",
        "segundo",
        "postre"
      ]
    }
  }
}
